{
  "name": "happy-time-plataforma",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma Curricular Happy Time y asistente pedagógica Happy",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "curriculum:gate": "tsx scripts/curriculum/cli.ts gate",
    "curriculum:compile": "tsx scripts/curriculum/cli.ts compile",
    "curriculum:check": "tsx scripts/curriculum/cli.ts check",
    "curriculum:diff": "tsx scripts/curriculum/cli.ts diff",
    "curriculum:verify-independent": "python3 -I scripts/curriculum/independent/verify_independent.py curriculum/source/SOURCE.lock.json",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run curriculum:check",
    "prototype:build": "tsx scripts/build-prototype.ts",
    "prototype:dev": "vite --config vite.config.ts",
    "test:e2e": "playwright test",
    "app:dev": "next dev",
    "app:build": "next build",
    "app:start": "next start",
    "app:check-bundle": "tsx scripts/check-app-bundle.ts",
    "test:e2e:app": "playwright test --config playwright.app.config.ts",
    "happy:eval": "tsx scripts/happy-eval.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.130.0",
    "@fontsource-variable/atkinson-hyperlegible-next": "5.3.0",
    "@fontsource-variable/fredoka": "5.3.0",
    "fast-xml-parser": "5.11.2",
    "fflate": "0.8.3",
    "minisearch": "7.2.0",
    "next": "16.3.8",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
